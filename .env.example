# RuraLearn Environment Configuration

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=ruralearn_secure_jwt_secret_key_2026_prod

# PostgreSQL Connection String (Optional for Cloud DBs like Neon, Supabase, Render, Railway, AWS)
# Example: postgresql://postgres:password@localhost:5432/ruralearn
DATABASE_URL=

# AI Doubt Box API Key (Optional - OpenAI or Gemini API)
AI_API_KEY=

# Frontend API URL (leave empty for relative /api in production)
VITE_API_URL=
